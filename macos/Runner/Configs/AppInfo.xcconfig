// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = SyncTV

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = org.synctv.app

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 SyncTV. All rights reserved.

// CI writes the optional file from encrypted repository secrets. These defaults
// keep local and fork builds ad-hoc signed and fully buildable.
SYNC_TV_CODE_SIGN_IDENTITY = -
SYNC_TV_CODE_SIGN_STYLE = Manual
SYNC_TV_DEVELOPMENT_TEAM =
SYNC_TV_PROVISIONING_PROFILE_SPECIFIER =
SYNC_TV_ENABLE_HARDENED_RUNTIME = NO
SYNC_TV_CODE_SIGN_INJECT_BASE_ENTITLEMENTS = YES
SYNC_TV_OTHER_CODE_SIGN_FLAGS =
#include? "../../Flutter/Signing.xcconfig"
CODE_SIGN_IDENTITY = $(SYNC_TV_CODE_SIGN_IDENTITY)
CODE_SIGN_STYLE = $(SYNC_TV_CODE_SIGN_STYLE)
DEVELOPMENT_TEAM = $(SYNC_TV_DEVELOPMENT_TEAM)
PROVISIONING_PROFILE_SPECIFIER = $(SYNC_TV_PROVISIONING_PROFILE_SPECIFIER)
ENABLE_HARDENED_RUNTIME = $(SYNC_TV_ENABLE_HARDENED_RUNTIME)
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = $(SYNC_TV_CODE_SIGN_INJECT_BASE_ENTITLEMENTS)
OTHER_CODE_SIGN_FLAGS = $(SYNC_TV_OTHER_CODE_SIGN_FLAGS)
